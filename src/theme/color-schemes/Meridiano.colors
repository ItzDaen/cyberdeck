[ColorEffects:Disabled]
# Neutral grey. A disabled widget has to look unlit, not coloured:
# that is why there is no tint, only a loss of contrast. A grey that
# is "unlit but coloured" reads as an error.
ChangeSelectionColor=true
Color=126,124,120
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
Enable=false
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
# The window that loses focus does not change colour, it changes
# contrast: that is what says "I am here, but you are not looking at
# me".
ChangeSelectionColor=true
Color=138,133,124
ColorAmount=0.0125
ColorEffect=2
ContrastAmount=0.10
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Window]
# The background of every native application. Warm black, not
# computer-science blue.
BackgroundNormal=14,13,11
BackgroundAlternate=22,21,19
DecorationFocus=255,157,46
DecorationHover=255,157,46
ForegroundActive=255,157,46
ForegroundInactive=138,133,124
ForegroundLink=255,157,46
ForegroundNegative=216,73,47
ForegroundNeutral=200,150,90
ForegroundNormal=232,228,220
ForegroundPositive=107,122,111
ForegroundVisited=200,150,90

[Colors:View]
# Surfaces you draw on: list views, tables, fields. One step below the
# window, because the content is "inside", not "on top of".
BackgroundNormal=26,25,23
BackgroundAlternate=34,32,29
DecorationFocus=255,157,46
DecorationHover=255,157,46
ForegroundActive=255,157,46
ForegroundInactive=138,133,124
ForegroundLink=255,157,46
ForegroundNegative=216,73,47
ForegroundNeutral=200,150,90
ForegroundNormal=232,228,220
ForegroundPositive=107,122,111
ForegroundVisited=200,150,90

[Colors:Header]
# Bars, table headers, window headers. One step above the view: it
# sits above, so the luminosity goes up.
BackgroundNormal=20,19,17
BackgroundAlternate=26,25,23
DecorationFocus=255,157,46
DecorationHover=255,157,46
ForegroundActive=255,157,46
ForegroundInactive=110,106,99
ForegroundLink=255,157,46
ForegroundNegative=216,73,47
ForegroundNeutral=200,150,90
ForegroundNormal=232,228,220
ForegroundPositive=107,122,111
ForegroundVisited=200,150,90

