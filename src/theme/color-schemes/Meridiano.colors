[Colors:Button]
# The buttons sit on the window, not on the view. Soft background,
# full text: that is the rule of the instrument, where the command has
# to be readable without dominating.
BackgroundNormal=34,32,29
BackgroundAlternate=42,40,36
DecorationFocus=255,157,46
DecorationHover=46,44,39
ForegroundActive=255,157,46
ForegroundInactive=110,106,99
ForegroundLink=255,157,46
ForegroundNegative=216,73,47
ForegroundNeutral=200,150,90
ForegroundNormal=232,228,220
ForegroundPositive=107,122,111
ForegroundVisited=200,150,90

[Colors:Complementary]
# "Special" surfaces: primary buttons, contextually selected items.
# Here amber appears as a background too, not only as text.
BackgroundNormal=34,32,29
BackgroundAlternate=26,25,23
DecorationFocus=255,157,46
DecorationHover=255,157,46
ForegroundActive=14,13,11
ForegroundInactive=110,106,99
ForegroundLink=255,157,46
ForegroundNegative=216,73,47
ForegroundNeutral=200,150,90
ForegroundNormal=232,228,220
ForegroundPositive=107,122,111
ForegroundVisited=200,150,90

[Colors:Selection]
# Selection is the one place where the background is lit amber.
# Everything else in the palette is unlit: that is how the selection
# is visible at a glance, rather than every line being coloured.
BackgroundNormal=255,157,46
BackgroundAlternate=138,83,32
DecorationFocus=255,157,46
DecorationHover=255,157,46
ForegroundActive=14,13,11
ForegroundInactive=200,150,90
ForegroundLink=14,13,11
ForegroundNegative=216,73,47
ForegroundNeutral=14,13,11
ForegroundNormal=14,13,11
ForegroundPositive=58,68,60
ForegroundVisited=14,13,11

[Colors:Tooltip]
# The tooltip is the one surface that lightens the dark theme, because
# everywhere else users expect black. Here it is inverted: light
# background, dark text. It is the exception that makes the rest
# readable.
BackgroundNormal=232,228,220
BackgroundAlternate=245,242,236
DecorationFocus=138,83,32
DecorationHover=138,83,32
ForegroundActive=14,13,11
ForegroundInactive=110,106,99
ForegroundLink=138,83,32
ForegroundNegative=176,52,32
ForegroundNeutral=138,83,32
ForegroundNormal=14,13,11
ForegroundPositive=58,68,60
ForegroundVisited=138,83,32

