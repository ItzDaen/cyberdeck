#!/bin/bash
# ==============================================================================
# game-performance — the CachyOS game-performance helper, plus CyberDeck
# performance mode.
#
# Why this file exists at all
# ---------------------------
# `game-performance %command%` as a launch option is a CachyOS thing:
# /usr/bin/game-performance ships in the `cachos-settings` package and only
# touches the CPU power profile through `powerprofilesctl launch -p
# performance`. It knows nothing about wallpapers, GPUs or the GPU.
#
# This wrapper shadows it on PATH (~/.local/bin precedes /usr/bin) to add the
# other half of what "performance mode" means here: yield the spectrum and
# swap the animated wallpapers for the still one, on every screen, for as
# long as the game runs. The CPU governor and the GPU are two different
# resources, and a launch option that only frees one of them frees half.
#
# What it used to get wrong, all three measured
# ---------------------------------------------
# 1. It called `cyberhud performance on --auto`. `--auto` is the timer path,
#    and it returns before `args` is ever read:
#
#        if getattr(args, "auto", False):
#            # --auto means "hands off, run at full tilt", and it means
#            # that unconditionally.
#            if set_performance(False, manual=False, ...)
#            return
#
#    So the command whose job is to turn performance mode ON was setting full
#    tilt. `--auto` used to mean "let the detector decide"; the detector was
#    then removed, and this wrapper was never updated. It now calls
#    `performance on`, which is the manual path: YIELD plus the GPU-free
#    wallpaper swap.
#
# 2. It looked for the manual marker at ~/.cache/cyberhud_perf_manual. That
#    path does not exist. cyberhud uses ~/.cache/cyberdeck/yield-manual, so
#    the check was always false and the "leave a hand-set mode alone" branch
#    never ran. A stale constant read as a working guard.
#
# 3. On exit it called `performance off`, which sets a *manual* marker: the
#    desktop was left in "full, by hand" instead of hands-off. `performance
#    auto` is the way back — it clears the marker, hands the wallpaper back
#    and says what is animating.
#
# 4. It could not tell its own marker from the user's. `performance on`
#    writes the manual marker, so a second game starting while the first
#    runs found the marker and gave up with "set by hand" -- even though
#    no hand was involved -- and stayed out of the refcount entirely.
#    Worse, every refusal and every handoff was silent (`>/dev/null`),
#    so a desktop that stopped yielding to games looked exactly like a
#    desktop whose wrapper was never called. The fix is an ownership
#    file next to the PID files: a mode the wrapper took is handed back
#    by the last wrapper out, and only a mode nobody's wrapper owns is
#    left alone. Plus a log, so the next diagnosis takes seconds.
#
# Neither this wrapper nor /usr/bin/game-performance was in the repository,
# which is why all three survived. It lives in src/bin/ now, and
# sync-packages.sh installs it like the other binaries.
# ==============================================================================

REAL_BIN="/usr/bin/game-performance"

if [ ! -x "$REAL_BIN" ]; then
    echo "game-performance: $REAL_BIN not found or not executable" >&2
    exit 1
fi

HUD="$HOME/.local/bin/cyberhud"
if [ ! -x "$HUD" ]; then
    echo "game-performance: $HUD not found, running the CachyOS helper alone" >&2
    exec "$REAL_BIN" "$@"
fi

# The marker cyberhud actually writes. See `YIELD_MANUAL` in src/bin/cyberhud;
# read it from there, do not copy the string.
YIELD_MANUAL="$HOME/.cache/cyberdeck/yield-manual"

# Who owns the current mode: a wrapper's, or nobody's. `performance on`
# writes the same manual marker whether a game or a hand asked for it,
# so the marker alone cannot tell them apart. This file can: it exists
# only while at least one wrapper instance holds the mode. A mode with
# this file is handed back by the last wrapper out; a mode without it
# is the user's and is never touched.
OWNED_MARKER_NAME="owned-by-games"

LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/cyberhud_game_lock"
LOCK_OK=0
if mkdir -p "$LOCK_DIR" 2>/dev/null && [ -d "$LOCK_DIR" ] && [ -w "$LOCK_DIR" ]; then
    LOCK_OK=1
else
    echo "game-performance: cannot write $LOCK_DIR, running without game lock" >&2
fi
PID_FILE="$LOCK_DIR/$$"

LOG_FILE="$HOME/.cache/cyberdeck/game-performance.log"
log() {
    # Best-effort and silent: logging must never break a game launch.
    { printf '%s pid=%s %s\n' "$(date '+%F %T')" "$$" "$*" >>"$LOG_FILE"; } 2>/dev/null
    if [ -f "$LOG_FILE" ] && [ "$(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)" -gt 131072 ]; then
        { tail -n 400 "$LOG_FILE" >"$LOG_FILE.tmp" && mv -f "$LOG_FILE.tmp" "$LOG_FILE"; } 2>/dev/null
    fi
    return 0
}

# Live game PIDs holding the mode. The ownership file itself is not a
# PID and is never counted here.
pids_vivi() {
    [ "$LOCK_OK" -eq 1 ] || return 0
    local f p
    for f in "$LOCK_DIR"/*; do
        [ -e "$f" ] || continue
        p=$(basename "$f")
        case "$p" in
            ''|*[!0-9]*) continue ;;
        esac
        if kill -0 "$p" 2>/dev/null; then
            printf '%s\n' "$p"
        fi
    done
}

# Remove lockfiles whose process is gone. Without this a SIGKILLed game
# leaves its PID file behind. Stale files no longer break the count --
# pids_vivi checks liveness -- but they would pile up forever, so they
# still go. The ownership file is not a PID file and is never touched
# here; it is created and removed only together with a handoff.
potatura_orfani() {
    [ "$LOCK_OK" -eq 1 ] || return 0
    local f p
    for f in "$LOCK_DIR"/*; do
        [ -e "$f" ] || continue
        p=$(basename "$f")
        case "$p" in
            ''|*[!0-9]*)
                [ "$p" = "$OWNED_MARKER_NAME" ] || rm -f "$f" 2>/dev/null
                continue ;;
        esac
        if ! kill -0 "$p" 2>/dev/null; then
            rm -f "$f" 2>/dev/null
        fi
    done
}

# Three states, decided in this order. Reaping runs first so a crashed
# wrapper's leftovers never read as somebody's game.
#
# - no marker: nobody holds the mode. Take it (PID file, ownership
#   file, `performance on`) and hand it back at exit.
# - marker, and (ownership file or a live game): another wrapper holds
#   it, or held it and crashed. Join it: take a PID file and share the
#   handoff. This is the case the old code got wrong -- it read its own
#   marker as the user's hand and stayed out of the count, so the mode
#   it had set was never handed back by anyone.
# - marker, nothing wrapper-shaped anywhere: the user set it by hand.
#   Not ours to change, in either direction.
MODO=ignoto
potatura_orfani
if [ ! -f "$YIELD_MANUAL" ]; then
    MODO=nostro
    if [ "$LOCK_OK" -eq 1 ]; then
        touch "$PID_FILE" 2>/dev/null || LOCK_OK=0
        [ "$LOCK_OK" -eq 1 ] && touch "$LOCK_DIR/$OWNED_MARKER_NAME" 2>/dev/null
    fi
    "$HUD" performance on >/dev/null 2>&1
    log "start mode=ours (took it)"
elif [ -f "$LOCK_DIR/$OWNED_MARKER_NAME" ] || [ -n "$(pids_vivi)" ]; then
    MODO=condiviso
    if [ "$LOCK_OK" -eq 1 ]; then
        touch "$PID_FILE" 2>/dev/null || true
    fi
    log "start mode=shared (joining another game)"
else
    MODO=manuale
    log "start mode=manual (leaving it alone)"
    echo "game-performance: performance mode was set by hand, leaving it" >&2
fi

cleanup() {
    rm -f "$PID_FILE" 2>/dev/null

    if [ "$LOCK_OK" -eq 1 ]; then
        potatura_orfani
    fi

    # Only a mode this wrapper owns or shares is handed back, and only
    # by the last one out. A manual mode returns here untouched.
    if [ "$MODO" = "manuale" ]; then
        log "exit mode=manual (nothing to hand back)"
        return 0
    fi

    local remaining=0
    if [ "$LOCK_OK" -eq 1 ]; then
        remaining=$(pids_vivi | wc -l)
    fi
    if [ "$remaining" -eq 0 ]; then
        # `auto`, not `off`: hands-off again, and it gives the wallpaper back.
        #
        # Known limit, stated not hidden: if the user ran `performance on`
        # by hand mid-game, this still hands back. Our own `performance on`
        # writes the same marker file, and the marker carries no timestamp,
        # so ours and theirs are indistinguishable at exit. Leaving the mode
        # on when the game that asked for it is gone would be the worse
        # failure; re-enabling by hand is one command.
        "$HUD" performance auto >/dev/null 2>&1
        rm -f "$LOCK_DIR/$OWNED_MARKER_NAME" 2>/dev/null
        log "exit last out, handed back"
    else
        log "exit $remaining still in, leaving it"
    fi
}

trap cleanup EXIT INT TERM HUP

# Not `exec`. The CachyOS helper execs powerprofilesctl, which waits for the
# game; exec here would replace this shell and the trap would never run, so
# performance mode would stay on after the game exited. Waiting is the point.
"$REAL_BIN" "$@"
exit $?
