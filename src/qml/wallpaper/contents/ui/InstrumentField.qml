// ==============================================================================
// InstrumentField.qml — The background.
// Author: Daen
//
// Replaces CyberMatrixBackground.qml (Matrix rain shader, GLSL, 60-144 FPS).
//
// Cost: one flat fill, one gradient and two greyscale textures.
// Zero ShaderEffect, zero animation, zero GPU consumption when idle.
// The screen is a matte, silent surface: the only thing that moves,
// across the whole identity, is the instrument that measures it.
// ==============================================================================
import QtQuick

Item {
    id: root
    anchors.fill: parent

    // ── 1. Base ────────────────────────────────────────────────────
    Rectangle {
        anchors.fill: parent
        color: Theme.field
    }

    // ── 2. Light from the corner ────────────────────────────────────
    // A real surface is not flat: it takes light from one side.
    // Two crossing gradients, both under 4% of difference: the
    // difference is not perceivable, but the brain records "material"
    // instead of "fill". It is the trick that separates flat graphics
    // from physical ones.
    Item {
        anchors.fill: parent
        opacity: 0.5

        // Horizontal axis: lighter on the left.
        Rectangle {
            anchors.fill: parent
            gradient: Gradient {
                orientation: Gradient.Horizontal
                GradientStop { position: 0.0; color: Theme.fieldLight }
                GradientStop { position: 0.5;  color: Theme.field }
                GradientStop { position: 1.0; color: Theme.field }
            }
        }

        // Vertical axis: lighter at the top. Crossing with the first
        // gives a hot spot at the top left, like a tilted panel.
        Rectangle {
            anchors.fill: parent
            gradient: Gradient {
                orientation: Gradient.Vertical
                GradientStop { position: 0.0; color: Qt.rgba(0, 0, 0, 0.18) }
                GradientStop { position: 0.5;  color: "transparent" }
                GradientStop { position: 1.0; color: Qt.rgba(0, 0, 0, 0.22) }
            }
        }
    }

    // ── 3. Grain ───────────────────────────────────────────────────
    // A 128x128 tileable film-grain texture. It is what distinguishes
    // a printed panel from a rectangle of colour: it removes the
    // banding on dark gradients and gives a tactile consistency.
    // Generated by tools/make-textures.py with a fixed seed -- it has
    // to be identical at every start, not change its randomness on
    // every restart.
    Image {
        anchors.fill: parent
        source: "grain.png"
        sourceSize.width: 128
        sourceSize.height: 128
        fillMode: Image.Tile
        asynchronous: true
        cache: true
        opacity: 0.5
    }

    // ── 4. Vignette ────────────────────────────────────────────
    // One only, radial, symmetric. It replaces the four overlapping
    // vignettes of the old main.qml (top, bottom, left, right), which
    // existed only to protect the legibility of the icons and amounted
    // to four overlapping gradients.
    Image {
        anchors.fill: parent
        source: "vignette.png"
        fillMode: Image.Stretch
        asynchronous: true
        cache: true
        smooth: true
    }
}
