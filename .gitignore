# ── Secrets: never in the repository ────────────────────────────
auth.token
*.token

# Machine-local configuration, merged over config.yaml by the server.
# It exists so that what is true of one machine -- the name you reach
# the deck on, a port you had to move -- never has to be committed and
# is never clobbered by tools/sync-packages.sh.
config.local.yaml

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Generated packages ──────────────────────────────────────────
# packages/ is the installed mirror of src/: regenerated by
# tools/sync-packages.sh, never edited by hand and never committed.
/packages/
# /src/web/static/*.map

# ── Editor / OS ─────────────────────────────────────────────────
*.swp
*~
.DS_Store
.idea/
.vscode/
